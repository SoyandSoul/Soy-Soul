+  ["paint", "Lackiererei", "Eigene Livery für die ganze Flotte malen", '<path d="M4 20c2 0 4-1 4-4l9-9 3 3-9 9c-3 0-4 2-4 4"/><path d="M14 6l4 4"/>'],
